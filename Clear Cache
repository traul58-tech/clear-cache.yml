name: Cleanup Old Caches

on:
  schedule:
    - cron: '0 0 * * *' # Runs every night at midnight UTC
  workflow_dispatch:   # Allows manual trigger via the Actions tab

permissions:
  actions: write

jobs:
  cleanup:
    runs-on: ubuntu-latest
    steps:
      - name: Purge aged caches
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          # Set your retention window here (e.g., 5 days)
          DAYS_TO_KEEP: 5
        run: |
          # Calculate the ISO 8601 date cutoff in UTC
          CUTOFF_DATE=$(date -u -d "$DAYS_TO_KEEP days ago" +"%Y-%m-%dT%H:%M:%SZ")
          echo "Deleting caches last accessed before: $CUTOFF_DATE"

          # 1. Fetch caches from the repository REST API
          # 2. Parse using jq to select items older than the cutoff
          # 3. Extract the cache IDs and delete them sequentially
          gh api /repos/${{ github.repository }}/actions/caches --paginate \
            --jq ".actions_caches[] | select(.last_accessed_at < \"$CUTOFF_DATE\") | .id" | \
            while read -r cache_id; do
              if [ -n "$cache_id" ]; then
                echo "Deleting old cache ID: $cache_id"
                gh cache delete "$cache_id" || true
              fi
            done

